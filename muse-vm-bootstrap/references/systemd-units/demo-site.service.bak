[Unit]
Description=Demo site static server on :18080
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hatch/workspace/demo-site
ExecStart=/usr/bin/python3 -m http.server 18080 --bind 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
